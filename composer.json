{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "agence104/livekit-server-sdk": "^1.3",
        "cerbero/json-parser": "^1.1",
        "filament/filament": "^5.0",
        "guzzlehttp/guzzle": "^7.9",
        "intervention/image": "^3.11",
        "kreait/firebase-php": "^7.21",
        "kreait/laravel-firebase": "^6.1",
        "laravel/framework": "^12.53",
        "laravel/horizon": "^5.45",
        "laravel/octane": "^2.12",
        "laravel/reverb": "^1.8",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.18",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "3.0",
        "pusher/pusher-php-server": "^7.2",
        "rmsramos/activitylog": "^2.0",
        "sentry/sentry-laravel": "^4.18",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-data": "^4.15",
        "spatie/laravel-medialibrary": "^11.12",
        "spatie/laravel-model-status": "^1.18",
        "spatie/laravel-permission": "^7.2",
        "spatie/laravel-query-builder": "^6.3",
        "spatie/laravel-webhook-client": "^3.4"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": "^2.1",
        "fakerphp/faker": "^1.23",
        "knuckleswtf/scribe": "v5.x-dev",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.3.4",
        "laravel/envoy": "^2.10",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "laravel/wayfinder": "dev-next",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.1",
        "rector/rector": "^2.2",
        "spatie/boost-spatie-guidelines": "^1.1",
        "spatie/laravel-typescript-transformer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
